# EAS ignore rules for the root repository
# Keeps build package small while allowing the Firebase configuration files

node_modules/
backend/.venv/
backend/.pytest_cache/
.expo/
.metro-cache/
dist/
web-build/
expo-env.d.ts

.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

.DS_Store
*.pem

# Segredos de servidor na raiz — NUNCA subir. Mantém apenas frontend/.env (só EXPO_PUBLIC_*).
/.env
/.env.*
.env*.local
*.tsbuildinfo
app-example

# Backend inteiro não faz parte do build do app Expo — evita subir código e segredos do servidor.
backend/

# GCP Credentials (MUST NEVER BE UPLOADED)
service-account-key.json
backend/service-account-key.json

# Allow the Firebase services files by omitting them from this ignore file!
